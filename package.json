{
  "name": "zcars",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s build-only type-check",
    "preview": "vite preview",
    "build-only": "vite-ssg build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false && vue-tsc --noEmit -p tsconfig.config.json --composite false",
    "check:hours": "node scripts/hours.check.ts",
    "lint": "eslint . --max-warnings=0 --fix",
    "prepare": "husky && vite build --outDir node_modules/.cache/zcars-prepare --emptyOutDir",
    "clear:auto-generated": "rm -rf src/types/index.ts src/composables/index.ts src/utils/index.ts ./auto-imports.d.ts ./components.d.ts ./typed-router.d.ts ./auto-import.json"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --max-warnings=0 --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "**/*.{html,css,scss,json,md}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@vueuse/core": "^12.8.2",
    "motion-v": "^2.5.2",
    "vue": "^3.5.17",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sass": "^1.85.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^28.4.1",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^6.0.11",
    "vite-plugin-vue-devtools": "^7.7.0",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^2.2.0",
    "zod": "^4.6.5"
  }
}
